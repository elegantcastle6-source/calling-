# Copy to .env.local (never commit .env.local with real credentials).
# Set these from your verified Agora Console project.
NEXT_PUBLIC_AGORA_APP_ID=YOUR_AGORA_APP_ID
# Server-only secret used by /api/rtc-token (never prefix with NEXT_PUBLIC_).
AGORA_APP_CERTIFICATE=YOUR_AGORA_APP_CERTIFICATE
NEXT_PUBLIC_DEFAULT_CHANNEL=justchat_1on1_demo

# Copy to .env.local (never commit .env.local with real credentials).
# Set these from your verified Agora Console project and deployed token server.
APP_ID=YOUR_AGORA_APP_ID
CHANNEL_NAME=justchat_1on1_demo
TOKEN_SERVER=https://your-token-server.example.com/api/token

# Server-only secret if also using the built-in /api/rtc-token route.
AGORA_APP_CERTIFICATE=YOUR_AGORA_APP_CERTIFICATE

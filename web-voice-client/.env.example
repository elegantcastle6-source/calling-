# Copy to .env.local (never commit real credentials).
# Keep AGORA_APP_CERTIFICATE strictly on your token server — never put it in browser env vars.
VITE_AGORA_APP_ID=YOUR_AGORA_APP_ID
VITE_AGORA_CHANNEL_NAME=justchat_voice_room
# Optional HTTPS endpoint of your Go token server (e.g. https://your-token-server.example.com/rtc-token).
# For First Success testing, leave blank and paste a Console temporary token matching channel + UID in the UI.
VITE_AGORA_TOKEN_SERVER_URL=

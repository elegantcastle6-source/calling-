# Environment variables and API keys for Just Chat
# Configure your Agora App ID in the AI Studio Secrets panel.
AGORA_APP_ID=YOUR_AGORA_APP_ID
# Fixed Agora channel name (or leave as default for per-contact channels).
AGORA_CHANNEL_NAME=OPTIONAL_AGORA_CHANNEL_NAME
# HTTPS endpoint of your Agora RTC token server (e.g. https://your-token-server.example.com/api/token).
# Keep AGORA_APP_CERTIFICATE strictly on your server — never put it in the Android app.
AGORA_TOKEN_SERVER_URL=OPTIONAL_AGORA_TOKEN_SERVER_URL
